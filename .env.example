# Скопируйте в .env и заполните нужное. Пустой файл тоже рабочий:
# без единой переменной поднимается всё, кроме бота.

# --- Разбор и ответы на вопросы -------------------------------------------
# rules  — детерминированный разбор из чисел партии. Значение по умолчанию,
#          сети не требует, работает офлайн и в CI.
# model  — внешняя модель по OpenAI-совместимому протоколу. Требует ключ:
#          при COACH_PROVIDER=model без COACH_API_KEY приложение не стартует,
#          а не переключается на rules молча.
COACH_PROVIDER=rules
COACH_API_KEY=
COACH_BASE_URL=https://openrouter.ai/api/v1
COACH_MODEL=qwen/qwen3-235b-a22b
COACH_TIMEOUT_MS=12000

# --- Проверка подписи Telegram --------------------------------------------
# Пусто — приложение работает как обычный сайт и подпись не спрашивает.
# Задан токен — заголовок X-Telegram-Init-Data становится обязательным
# для /api/review и /api/coach, и проверяется HMAC-ом от этого токена.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MAX_AGE_SECONDS=86400

# --- Бот -------------------------------------------------------------------
# Токен от @BotFather. Без него бот не запускается (и не должен).
BOT_TOKEN=
# Адрес, по которому развёрнут веб-клиент. Telegram открывает мини-апп
# только по https.
WEB_APP_URL=https://example.org
